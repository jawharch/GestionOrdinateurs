# Copy this file to .env and replace the example values before using Docker Compose.
DOCKER_ACCOUNT=your-docker-hub-username
MYSQL_USER=user
MYSQL_PASSWORD=change-this-local-password
JWT_KEY=replace-this-with-a-random-secret-of-at-least-32-bytes
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-local-password
