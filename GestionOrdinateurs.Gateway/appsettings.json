{
  "ReverseProxy": {
    "Routes": {
      "ordinateurs": {
        "ClusterId": "gestion-ordinateurs-api",
        "Match": {
          "Path": "/api/ordinateurs/{**catch-all}"
        }
      },
      "reparations": {
        "ClusterId": "gestion-ordinateurs-api",
        "Match": {
          "Path": "/api/reparations/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "gestion-ordinateurs-api": {
        "Destinations": {
          "gestion-ordinateurs-api": {
            "Address": "http://localhost:5113/"
          }
        }
      }
    }
  }
}
